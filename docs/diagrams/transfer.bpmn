      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10">
        <di:waypoint x="1075" y="60" />
        <di:waypoint x="1173" y="60" />
        <di:waypoint x="1173" y="142" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f11_di" bpmnElement="f11">
        <di:waypoint x="1075" y="160.0" />
        <di:waypoint x="1155" y="160.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f12_di" bpmnElement="f12">
        <di:waypoint x="1000" y="218" />
        <di:waypoint x="1000" y="255" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f13_di" bpmnElement="f13">
        <di:waypoint x="1075" y="295" />
        <di:waypoint x="1173" y="295" />
        <di:waypoint x="1173" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f14_di" bpmnElement="f14">
        <di:waypoint x="270" y="160.0" />
        <di:waypoint x="305" y="160.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
