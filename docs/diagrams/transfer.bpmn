<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Vaultix" targetNamespace="https://vaultix.local/bpmn">
  <bpmn:process id="Transfer" isExecutable="false">
    <bpmn:startEvent id="start" name="Transfer received" />
    <bpmn:task id="auth" name="Authorize and validate request" />
    <bpmn:exclusiveGateway id="auth_ok" name="Authorized and valid?" />
    <bpmn:task id="lock" name="Lock key and check receipt" />
    <bpmn:exclusiveGateway id="receipt" name="Existing receipt?" />
    <bpmn:task id="replay" name="Return replay or key conflict" />
    <bpmn:task id="check" name="Lock accounts and evaluate rules" />
    <bpmn:exclusiveGateway id="eligible" name="Rules pass?" />
    <bpmn:task id="reject" name="Commit rejection receipt and audit" />
    <bpmn:task id="post" name="Post and commit journal and receipt" />
    <bpmn:boundaryEvent id="failure" name="Posting error" attachedToRef="post">
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:task id="rollback" name="Rollback and return internal error" />
    <bpmn:endEvent id="done" name="Response returned" />
    <bpmn:sequenceFlow id="f0" sourceRef="start" targetRef="auth" name="" />
    <bpmn:sequenceFlow id="f1" sourceRef="auth_ok" targetRef="lock" name="Authorized and valid" />
    <bpmn:sequenceFlow id="f2" sourceRef="auth_ok" targetRef="done" name="Invalid or unauthorized" />
    <bpmn:sequenceFlow id="f3" sourceRef="lock" targetRef="receipt" name="" />
    <bpmn:sequenceFlow id="f4" sourceRef="receipt" targetRef="replay" name="Yes" />
    <bpmn:sequenceFlow id="f5" sourceRef="replay" targetRef="done" name="" />
    <bpmn:sequenceFlow id="f6" sourceRef="receipt" targetRef="check" name="No" />
    <bpmn:sequenceFlow id="f7" sourceRef="check" targetRef="eligible" name="" />
    <bpmn:sequenceFlow id="f8" sourceRef="eligible" targetRef="reject" name="No" />
    <bpmn:sequenceFlow id="f9" sourceRef="eligible" targetRef="post" name="Yes" />
    <bpmn:sequenceFlow id="f10" sourceRef="reject" targetRef="done" name="" />
    <bpmn:sequenceFlow id="f11" sourceRef="post" targetRef="done" name="" />
    <bpmn:sequenceFlow id="f12" sourceRef="failure" targetRef="rollback" name="" />
    <bpmn:sequenceFlow id="f13" sourceRef="rollback" targetRef="done" name="" />
    <bpmn:sequenceFlow id="f14" sourceRef="auth" targetRef="auth_ok" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="TransferDiagram">
    <bpmndi:BPMNPlane id="TransferPlane" bpmnElement="Transfer">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="50" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="auth_di" bpmnElement="auth">
        <dc:Bounds x="120" y="120" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="auth_ok_di" bpmnElement="auth_ok">
        <dc:Bounds x="305" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lock_di" bpmnElement="lock">
        <dc:Bounds x="390" y="120" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="receipt_di" bpmnElement="receipt">
        <dc:Bounds x="575" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="replay_di" bpmnElement="replay">
        <dc:Bounds x="655" y="20" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="check_di" bpmnElement="check">
        <dc:Bounds x="655" y="120" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="eligible_di" bpmnElement="eligible">
        <dc:Bounds x="840" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reject_di" bpmnElement="reject">
        <dc:Bounds x="925" y="20" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="post_di" bpmnElement="post">
        <dc:Bounds x="925" y="120" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="failure_di" bpmnElement="failure">
        <dc:Bounds x="982" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rollback_di" bpmnElement="rollback">
        <dc:Bounds x="925" y="255" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="done_di" bpmnElement="done">
        <dc:Bounds x="1155" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f0_di" bpmnElement="f0">
        <di:waypoint x="86" y="160.0" />
        <di:waypoint x="120" y="160.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="355" y="160.0" />
        <di:waypoint x="390" y="160.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="330" y="185" />
        <di:waypoint x="330" y="380" />
        <di:waypoint x="1173" y="380" />
        <di:waypoint x="1173" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="540" y="160.0" />
        <di:waypoint x="575" y="160.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="600" y="135" />
        <di:waypoint x="600" y="60" />
        <di:waypoint x="655" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="805" y="60" />
        <di:waypoint x="825" y="60" />
        <di:waypoint x="825" y="8" />
        <di:waypoint x="1173" y="8" />
        <di:waypoint x="1173" y="142" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="625" y="160.0" />
        <di:waypoint x="655" y="160.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7">
        <di:waypoint x="805" y="160.0" />
        <di:waypoint x="840" y="160.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8">
